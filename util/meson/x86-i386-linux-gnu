[binaries]
c = '/usr/bin/gcc'
ar = '/usr/bin/ar'
nasm = '/usr/bin/nasm'
strip = '/usr/bin/strip'

[built-in options]
c_args = ['-m32']
c_link_args = ['-m32']

[build_machine]
system = 'linux'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[host_machine]
system = 'linux'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'

[properties]
is32bit = true
